# Copy to .env on the backend host only. Never place these values in the Android project.
PORT=8080
NODE_ENV=development
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=replace_with_a_new_rotated_key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Configure Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS on the server.
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
OTP_HASH_SECRET=replace_with_a_long_random_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-campus-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=AGENTRA AI CAMPUS <your-campus-email@gmail.com>
# Face Recognition (Advanced)
FACE_MODEL_NAME=arcface_resnet50
FACE_DETECTOR_BACKEND=opencv_dnn
FACE_COSINE_MATCH_THRESHOLD=0.72
FACE_COSINE_AMBIGUOUS_THRESHOLD=0.60
FACE_EUCLIDEAN_MATCH_THRESHOLD=0.85
FACE_EUCLIDEAN_AMBIGUOUS_THRESHOLD=0.75
FACE_REQUIRE_BOTH_METRICS=true
FACE_REQUIRED_LIVENESS=true
FACE_MIN_LIVENESS_CONFIDENCE=0.80
# Optional comma-separated allowed origins for web clients; Android requests do not depend on CORS.
CORS_ORIGINS=
